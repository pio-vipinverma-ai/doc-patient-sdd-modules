# AI assistant/workflow ignore rules
# Keep generated artifacts and dependencies out of AI context scans

# Dependencies
node_modules/

# Build outputs
backend/dist/
frontend/dist/
frontend/.vite/

# Coverage and test artifacts
backend/coverage/
frontend/coverage/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files
.env
.env.*

# Python cache
__pycache__/
*.pyc

# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# BMAD generated output artifacts (large and frequently regenerated)
_bmad-output/implementation-artifacts/
_bmad-output/planning-artifacts/
